# 箭牌智家 AI 助手 · BRTC H5 平台版（端口 8900，避开 Agent API demo 的 8898）
PORT=8900

# ---- BRTC 四件套（勿提交）----
# AppID：https://console.bce.baidu.com/rtc/#/rtc/interaction
BRTC_APPID=
# AK/SK：https://console.bce.baidu.com/iam/#/iam/accesslist
# 只留在本服务，用来调 generateAIAgentCall。不会下发到浏览器。
BRTC_AK=
BRTC_SK=
# licensekey 列，不是资源 id：https://console.bce.baidu.com/rtc/#/rtc/resource
# 必须和上面的 AppID 绑定，且与 AK/SK 同一账号。
BRTC_LICKEY=

# 设备号必须固定。后端用 licenseKey + appId + deviceId 记一次激活，
# 每次换号都算新设备，会持续消耗激活次数。
BRTC_DEVID=DEVID-ARROW-H5-0001

# 建实例。这个 AppID 在示例网关 ai.agent.kaywang.cn 上会回 No such app，
# 走百度智能云正式接口，用 AK/SK 做 BCE v3 签名。
# BRTC_API_HOST=https://rtc-aiagent.baidubce.com
# BRTC_INSTANCE_TYPE=VoiceChat

# ---- IoT 网关（与箭牌 Agent API demo 同一套）----
# mock = 起本地网关；real = 打箭牌 UAT
IOT_MODE=real
IOT_PORT=18901
IOT_BASE_URL=https://api-uatiot.arrowgroup.com.cn
IOT_TOKEN=
# 改回本地：IOT_MODE=mock，并填 IOT_TOKEN=demo-token
